{
  "$schema": "urn:marketpilot:paper-intent-fixture:v1:meta",
  "$id": "urn:marketpilot:paper-intent-fixture:v1:primitives",
  "type": "object",
  "properties": {},
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "UtcTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 24, "max": 24}},
    "UsdPrice": {"type": "string", "pattern": "^(?!0\\.0000(?![\\s\\S]))(?:0\\.[0-9]{4}|[1-9][0-9]{0,5}\\.[0-9]{4})(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 6, "max": 11}},
    "UsdCollarPrice": {"type": "string", "pattern": "^(?!0\\.0000(?![\\s\\S]))(?!1004999\\.9999(?![\\s\\S]))(?:0\\.[0-9]{4}|[1-9][0-9]{0,5}\\.[0-9]{4}|100[0-4][0-9]{3}\\.[0-9]{4})(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 6, "max": 12}},
    "ShareQuantity": {"type": "string", "pattern": "^(?!0\\.000000(?![\\s\\S]))(?:0\\.[0-9]{6}|[1-9][0-9]{0,5}\\.[0-9]{6}|1000000\\.000000)(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 8, "max": 14}},
    "UnsignedUsdAmount": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 4, "max": 12}},
    "Ratio": {"type": "string", "pattern": "^(?:0\\.[0-9]{6}|1\\.000000)(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 8, "max": 8}},
    "Text": {"type": "string", "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 1, "max": 1024}},
    "Hash": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 64, "max": 64}},
    "OpaqueId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 3, "max": 64}},
    "RequestId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^req_[a-z0-9_]*(?![\\s\\S])"}]},
    "OperationId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^op_[a-z0-9_]*(?![\\s\\S])"}]},
    "JobKey": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^job_[a-z0-9_]*(?![\\s\\S])"}]},
    "ResearchEventId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^re_[a-z0-9_]*(?![\\s\\S])"}]},
    "RevisionId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^rev_[a-z0-9_]*(?![\\s\\S])"}]},
    "FactId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^fact_[a-z0-9_]*(?![\\s\\S])"}]},
    "ProvenanceId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^prov_[a-z0-9_]*(?![\\s\\S])"}]},
    "CandidateId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^cand_[a-z0-9_]*(?![\\s\\S])"}]},
    "TradeIntentId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^ti_[a-z0-9_]*(?![\\s\\S])"}]},
    "CriticVerdictId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^cv_[a-z0-9_]*(?![\\s\\S])"}]},
    "GateDecisionId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^gd_[a-z0-9_]*(?![\\s\\S])"}]},
    "OrderPlanId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^plan_[a-z0-9_]*(?![\\s\\S])"}]},
    "ExecutionId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^exec_[a-z0-9_]*(?![\\s\\S])"}]},
    "AuditId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^audit_[a-z0-9_]*(?![\\s\\S])"}]},
    "AuditEventId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^ae_[a-z0-9_]*(?![\\s\\S])"}]},
    "IncidentId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^inc_[a-z0-9_]*(?![\\s\\S])"}]},
    "RunId": {"allOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "string", "pattern": "^run_[a-z0-9_]*(?![\\s\\S])"}]},
    "InstrumentId": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{0,9}(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 1, "max": 10}},
    "Currency": {"type": "string", "pattern": "^[A-Z]{3}(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 3, "max": 3}},
    "SourceId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 3, "max": 64}},
    "SourceRevision": {"type": "string", "pattern": "^[!-~]+(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 1, "max": 128}},
    "StrategyKind": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}(?![\\s\\S])", "mpNfc": true, "mpScalarLength": {"min": 3, "max": 64}},
    "RightsClass": {"enum": ["PUBLIC_OFFICIAL", "LICENSED_MODEL_OK", "LOCAL_RESTRICTED"]},
    "SourceClass": {"enum": ["PUBLIC_OFFICIAL", "LICENSED_VENDOR", "LOCAL"]},
    "AssetClass": {"enum": ["US_PRIMARY_LISTED_COMMON_STOCK", "PLAIN_UNLEVERED_ETF"]},
    "Action": {"enum": ["OPEN_LONG", "CLOSE_LONG", "HOLD"]},
    "Side": {"enum": ["BUY", "SELL"]},
    "Session": {"enum": ["REGULAR", "EXTENDED"]},
    "DomainReasonCode": {"enum": ["INTENT_CANDIDATE_MISMATCH", "INTENT_EVIDENCE_MISMATCH", "CRITIC_INTENT_MISMATCH", "CRITIC_CANDIDATE_MISMATCH", "CRITIC_NOT_DISTINCT", "TIME_ORDER_INVALID", "CANDIDATE_INACTIVE", "RIGHTS_NOT_PUBLIC", "EVIDENCE_STALE", "INTENT_STALE", "CRITIC_STALE", "INTENT_ABSTAINED", "CRITIC_MISSING", "CRITIC_REJECTED", "CRITIC_ABSTAINED", "FIXTURE_POLICY_MISMATCH", "CANDIDATE_NOT_PAPER", "CANDIDATE_LIVE_ELIGIBLE", "INSTRUMENT_NOT_ALLOWED", "CURRENCY_NOT_USD", "ACTION_NOT_ALLOWED", "SIDE_NOT_ALLOWED", "SESSION_NOT_REGULAR", "QUANTITY_LIMIT_EXCEEDED", "NOTIONAL_LIMIT_EXCEEDED", "PRICE_NOT_MARKETABLE"]}
  }
}
