    "fillNotionalUsd": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UnsignedUsdAmount"},
    "commissionUsd": {"allOf": [{"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UnsignedUsdAmount"}, {"const": "0.00"}]},
