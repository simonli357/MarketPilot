{
  "$schema": "urn:marketpilot:paper-intent-fixture:v1:meta",
  "$id": "urn:marketpilot:paper-intent-fixture:v1:candidate-manifest",
  "type": "object",
  "required": ["schemaVersion", "profile", "artifactType", "candidateId", "candidateHash", "producer", "createdAt", "validFrom", "validUntil", "mode", "liveEligible", "strategyKind", "instrumentId", "assetClass", "currency", "policy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"const": "marketpilot.paper-intent-fixture.v1"},
    "artifactType": {"const": "CandidateManifest"},
    "candidateId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/CandidateId"},
    "candidateHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "producer": {"allOf": [{"$ref": "urn:marketpilot:paper-intent-fixture:v1:producer"}, {"type": "object", "properties": {"kind": {"const": "FIXTURE_REGISTRY"}}, "required": ["kind"]}]},
    "createdAt": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "validFrom": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "validUntil": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "mode": {"enum": ["PAPER", "LIVE"]},
    "liveEligible": {"type": "boolean"},
    "strategyKind": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/StrategyKind"},
    "instrumentId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/InstrumentId"},
    "assetClass": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/AssetClass"},
    "currency": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Currency"},
    "policy": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:policy"}
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
