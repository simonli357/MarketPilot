{
  "$schema": "urn:marketpilot:paper-intent-fixture:v1:meta",
  "$id": "urn:marketpilot:paper-intent-fixture:v1:audit-event",
  "type": "object",
  "required": ["schemaVersion", "profile", "policyId", "artifactType", "auditId", "auditEventId", "sequence", "occurredAt", "eventType", "subjectType", "subjectId", "subjectHash", "previousEventHash", "eventHash"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"const": "marketpilot.paper-intent-fixture.v1"},
    "policyId": {"const": "FIXTURE_LONG_US_EQUITY_100_V1"},
    "artifactType": {"const": "AuditEvent"},
    "auditId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/AuditId"},
    "auditEventId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/AuditEventId"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 16},
    "occurredAt": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "eventType": {"enum": ["INPUT_RESEARCH_RECORDED", "INPUT_CANDIDATE_RECORDED", "INPUT_INTENT_RECORDED", "INPUT_CRITIC_RECORDED", "GATE_DECIDED", "ORDER_PLANNED", "EXECUTION_SIMULATED"]},
    "subjectType": {"enum": ["ResearchEvent", "CandidateManifest", "TradeIntent", "CriticVerdict", "GateDecision", "OrderPlan", "ExecutionEvent"]},
    "subjectId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/OpaqueId"},
    "subjectHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "previousEventHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "eventHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"}
  },
  "$defs": {
    "BranchFields": {
      "type": "object",
      "properties": {
        "schemaVersion": true,
        "profile": true,
        "policyId": true,
        "artifactType": true,
        "auditId": true,
        "auditEventId": true,
        "sequence": true,
        "occurredAt": true,
        "eventType": true,
        "subjectType": true,
        "subjectId": true,
        "subjectHash": true,
        "previousEventHash": true,
        "eventHash": true
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"eventType": {"const": "INPUT_RESEARCH_RECORDED"}}, "required": ["eventType"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"subjectType": {"const": "ResearchEvent"}, "subjectId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/ResearchEventId"}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"eventType": {"const": "INPUT_CANDIDATE_RECORDED"}}, "required": ["eventType"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"subjectType": {"const": "CandidateManifest"}, "subjectId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/CandidateId"}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"eventType": {"const": "INPUT_INTENT_RECORDED"}}, "required": ["eventType"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"subjectType": {"const": "TradeIntent"}, "subjectId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/TradeIntentId"}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"eventType": {"const": "INPUT_CRITIC_RECORDED"}}, "required": ["eventType"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"subjectType": {"const": "CriticVerdict"}, "subjectId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/CriticVerdictId"}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"eventType": {"const": "GATE_DECIDED"}}, "required": ["eventType"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"subjectType": {"const": "GateDecision"}, "subjectId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/GateDecisionId"}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"eventType": {"const": "ORDER_PLANNED"}}, "required": ["eventType"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"subjectType": {"const": "OrderPlan"}, "subjectId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/OrderPlanId"}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"eventType": {"const": "EXECUTION_SIMULATED"}}, "required": ["eventType"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"subjectType": {"const": "ExecutionEvent"}, "subjectId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/ExecutionId"}}, "unevaluatedProperties": false}}
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false
}
