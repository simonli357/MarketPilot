{
  "$schema": "urn:marketpilot:paper-intent-fixture:v1:meta",
  "$id": "urn:marketpilot:paper-intent-fixture:v1:trade-intent",
  "type": "object",
  "required": ["schemaVersion", "profile", "artifactType", "intentId", "intentHash", "producer", "operationId", "createdAt", "expiresAt", "candidateId", "candidateHash", "disposition", "proposal", "abstainReasonCode", "thesis", "evidenceRefs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"const": "marketpilot.paper-intent-fixture.v1"},
    "artifactType": {"const": "TradeIntent"},
    "intentId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/TradeIntentId"},
    "intentHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "producer": {"allOf": [{"$ref": "urn:marketpilot:paper-intent-fixture:v1:producer"}, {"type": "object", "properties": {"kind": {"const": "MANAGER"}}, "required": ["kind"]}]},
    "operationId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/OperationId"},
    "createdAt": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "expiresAt": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "candidateId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/CandidateId"},
    "candidateHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "disposition": {"enum": ["PROPOSE", "ABSTAIN"]},
    "proposal": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/Proposal"}]},
    "abstainReasonCode": {"enum": ["INSUFFICIENT_EVIDENCE", "NO_SUPPORTED_ACTION", "UNSAFE_CONTEXT", null]},
    "thesis": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Text"},
    "evidenceRefs": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/EvidenceRef"}, "mpSortedUniqueBy": "eventId"}
  },
  "allOf": [
    {"if": {"properties": {"disposition": {"const": "PROPOSE"}}, "required": ["disposition"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"proposal": {"$ref": "#/$defs/Proposal"}, "abstainReasonCode": {"type": "null"}, "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 1}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"disposition": {"const": "ABSTAIN"}}, "required": ["disposition"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"proposal": {"type": "null"}, "abstainReasonCode": {"enum": ["INSUFFICIENT_EVIDENCE", "NO_SUPPORTED_ACTION", "UNSAFE_CONTEXT"]}}, "unevaluatedProperties": false}}
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "BranchFields": {
      "type": "object",
      "properties": {
        "schemaVersion": true,
        "profile": true,
        "artifactType": true,
        "intentId": true,
        "intentHash": true,
        "producer": true,
        "operationId": true,
        "createdAt": true,
        "expiresAt": true,
        "candidateId": true,
        "candidateHash": true,
        "disposition": true,
        "proposal": true,
        "abstainReasonCode": true,
        "thesis": true,
        "evidenceRefs": true
      }
    },
    "Proposal": {
      "type": "object",
      "required": ["action", "instrumentId", "assetClass", "currency", "side", "session", "quantity", "maximumEntryPrice"],
      "properties": {
        "action": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Action"},
        "instrumentId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/InstrumentId"},
        "assetClass": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/AssetClass"},
        "currency": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Currency"},
        "side": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Side"},
        "session": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Session"},
        "quantity": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/ShareQuantity"},
        "maximumEntryPrice": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UsdPrice"}
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "EvidenceRef": {
      "type": "object",
      "required": ["eventId", "eventHash", "factIds"],
      "properties": {
        "eventId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/ResearchEventId"},
        "eventHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
        "factIds": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/FactId"}, "mpSortedUniqueBy": "$value"}
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  }
}
