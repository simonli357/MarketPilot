    {"if": {"properties": {"boundary": {"const": "MCP"}}, "required": ["boundary"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"code": {"const": "MCP_CONTRACT_INVALID"}}, "unevaluatedProperties": false}},
