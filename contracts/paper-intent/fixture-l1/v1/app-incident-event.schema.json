    {"if": {"properties": {"boundary": {"const": "SIMULATOR"}}, "required": ["boundary"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"code": {"const": "PARTIAL_FILL_UNSUPPORTED"}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"boundary": {"const": "CORRECTION"}}, "required": ["boundary"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"code": {"const": "CORRECTION_REQUIRES_NEW_OPERATION"}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"boundary": {"const": "RECOVERY"}}, "required": ["boundary"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"code": {"const": "RECOVERY_INCOMPLETE"}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"boundary": {"const": "SCHEDULER"}}, "required": ["boundary"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"code": {"enum": ["SCHEDULER_CIRCUIT_OPEN", "SCHEDULER_RESULT_INVALID", "SCHEDULER_RECOVERY_ABSTAINED", "SCHEDULER_LEASE_UNCERTAIN", "SCHEDULER_STATE_INVALID"]}}, "unevaluatedProperties": false}}
