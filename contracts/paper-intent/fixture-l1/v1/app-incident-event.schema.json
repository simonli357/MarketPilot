    {"if": {"properties": {"boundary": {"const": "CLEANUP"}}, "required": ["boundary"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"code": {"const": "CLIENT_CLEANUP_FAILED"}}, "unevaluatedProperties": false}},
