{
  "$schema": "urn:marketpilot:paper-intent-fixture:v1:meta",
  "$id": "urn:marketpilot:paper-intent-fixture:v1:order-plan",
  "type": "object",
  "required": ["schemaVersion", "profile", "policyId", "artifactType", "planId", "planHash", "producer", "operationId", "decisionId", "decisionHash", "candidateId", "candidateHash", "intentId", "intentHash", "createdAt", "instrumentId", "assetClass", "currency", "side", "quantity", "orderType", "limitPrice", "routing", "timeInForce", "session", "simulationOnly", "priceCollar"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"const": "marketpilot.paper-intent-fixture.v1"},
    "policyId": {"const": "FIXTURE_LONG_US_EQUITY_100_V1"},
    "artifactType": {"const": "OrderPlan"},
    "planId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/OrderPlanId"},
    "planHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "producer": {"allOf": [{"$ref": "urn:marketpilot:paper-intent-fixture:v1:producer"}, {"type": "object", "properties": {"kind": {"const": "PYTHON_AUTHORITY"}}, "required": ["kind"]}]},
    "operationId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/OperationId"},
    "decisionId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/GateDecisionId"},
    "decisionHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "candidateId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/CandidateId"},
    "candidateHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "intentId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/TradeIntentId"},
    "intentHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "createdAt": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "instrumentId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/InstrumentId"},
    "assetClass": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/AssetClass"},
    "currency": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Currency"},
    "side": {"const": "BUY"},
    "quantity": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/ShareQuantity"},
    "orderType": {"const": "LIMIT"},
    "limitPrice": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UsdPrice"},
    "routing": {"const": "SMART"},
    "timeInForce": {"const": "DAY"},
    "session": {"const": "REGULAR"},
    "simulationOnly": {"const": true},
    "priceCollar": {
      "type": "object",
      "required": ["referencePrice", "maximumLimitPrice", "ratio"],
      "properties": {
        "referencePrice": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UsdPrice"},
        "maximumLimitPrice": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UsdCollarPrice"},
        "ratio": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Ratio"}
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
