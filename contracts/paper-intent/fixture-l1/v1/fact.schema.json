{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketpilot:paper-intent-fixture:v1:fact",
  "type": "object", "additionalProperties": false, "unevaluatedProperties": false,
  "required": ["factId", "kind", "value", "rightsClass", "provenanceId"],
  "properties": {"factId": {"type": "string", "pattern": "^fact_[a-z0-9_]{2,63}$"}, "kind": {"enum": ["NOTICE_TEXT", "REFERENCE_PRICE_USD", "ASK_PRICE_USD"]}, "value": {"type": "string", "minLength": 1, "maxLength": 1024}, "rightsClass": {"enum": ["PUBLIC_OFFICIAL", "LICENSED_MODEL_OK", "LOCAL_RESTRICTED"]}, "provenanceId": {"type": "string", "pattern": "^prov_[a-z0-9_]{2,63}$"}}
  ,"allOf": [
    {"if": {"properties": {"kind": {"const": "NOTICE_TEXT"}}}, "then": {"properties": {"value": {"minLength": 1, "maxLength": 1024}}}},
    {"if": {"properties": {"kind": {"enum": ["REFERENCE_PRICE_USD", "ASK_PRICE_USD"]}}}, "then": {"properties": {"value": {"pattern": "^(0|[1-9][0-9]*)\\.[0-9]{4}$"}}}}
  ]
}
