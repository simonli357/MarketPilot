{
  "$schema": "urn:marketpilot:paper-intent-fixture:v1:meta",
  "$id": "urn:marketpilot:paper-intent-fixture:v1:authority-request",
  "type": "object",
  "required": ["schemaVersion", "profile", "policyId", "messageType", "requestId", "operationId", "decisionAt", "bundle"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"const": "marketpilot.paper-intent-fixture.v1"},
    "policyId": {"const": "FIXTURE_LONG_US_EQUITY_100_V1"},
    "messageType": {"const": "EVALUATE_FIXTURE_PAPER_INTENT"},
    "requestId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/RequestId"},
    "operationId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/OperationId"},
    "decisionAt": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "bundle": {
      "type": "object",
      "required": ["researchEvent", "candidateManifest", "tradeIntent", "criticVerdict"],
      "properties": {
        "researchEvent": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:research-event"},
        "candidateManifest": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:candidate-manifest"},
        "tradeIntent": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:trade-intent"},
        "criticVerdict": {"anyOf": [{"type": "null"}, {"$ref": "urn:marketpilot:paper-intent-fixture:v1:critic-verdict"}]}
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
