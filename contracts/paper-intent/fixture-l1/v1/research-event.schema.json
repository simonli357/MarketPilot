{
  "$schema": "urn:marketpilot:paper-intent-fixture:v1:meta",
  "$id": "urn:marketpilot:paper-intent-fixture:v1:research-event",
  "type": "object",
  "required": ["schemaVersion", "profile", "artifactType", "eventId", "eventHash", "producer", "instrumentId", "assetClass", "currency", "eventKind", "revisionId", "supersedesEventId", "rightsClass", "publishedAt", "observedAt", "facts", "provenance"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"const": "marketpilot.paper-intent-fixture.v1"},
    "artifactType": {"const": "ResearchEvent"},
    "eventId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/ResearchEventId"},
    "eventHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "producer": {"allOf": [{"$ref": "urn:marketpilot:paper-intent-fixture:v1:producer"}, {"type": "object", "properties": {"kind": {"const": "FIXTURE_SOURCE"}}, "required": ["kind"]}]},
    "instrumentId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/InstrumentId"},
    "assetClass": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/AssetClass"},
    "currency": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Currency"},
    "eventKind": {"const": "FIXTURE_ISSUER_NOTICE"},
    "revisionId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/RevisionId"},
    "supersedesEventId": {"anyOf": [{"type": "null"}, {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/ResearchEventId"}]},
    "rightsClass": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/RightsClass"},
    "publishedAt": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "observedAt": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "facts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:fact"},
      "mpSortedUniqueBy": "factId",
      "allOf": [
        {"contains": {"type": "object", "properties": {"kind": {"const": "NOTICE_TEXT"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"kind": {"const": "REFERENCE_PRICE_USD"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"kind": {"const": "ASK_PRICE_USD"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "provenance": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:provenance"}, "mpSortedUniqueBy": "provenanceId"}
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
