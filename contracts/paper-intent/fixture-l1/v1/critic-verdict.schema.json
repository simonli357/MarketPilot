{
  "$schema": "urn:marketpilot:paper-intent-fixture:v1:meta",
  "$id": "urn:marketpilot:paper-intent-fixture:v1:critic-verdict",
  "type": "object",
  "required": ["schemaVersion", "profile", "artifactType", "verdictId", "verdictHash", "producer", "operationId", "createdAt", "expiresAt", "candidateId", "candidateHash", "intentId", "intentHash", "eventId", "eventHash", "verdict", "reasonCode", "counterargument", "evidenceFactIds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"const": "marketpilot.paper-intent-fixture.v1"},
    "artifactType": {"const": "CriticVerdict"},
    "verdictId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/CriticVerdictId"},
    "verdictHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "producer": {"allOf": [{"$ref": "urn:marketpilot:paper-intent-fixture:v1:producer"}, {"type": "object", "properties": {"kind": {"const": "CRITIC"}}, "required": ["kind"]}]},
    "operationId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/OperationId"},
    "createdAt": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "expiresAt": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "candidateId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/CandidateId"},
    "candidateHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "intentId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/TradeIntentId"},
    "intentHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "eventId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/ResearchEventId"},
    "eventHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "verdict": {"enum": ["APPROVE", "REJECT", "ABSTAIN"]},
    "reasonCode": {"enum": ["NO_BLOCKING_ISSUE", "EVIDENCE_GAP", "THESIS_CONTRADICTION", "FIXTURE_POLICY_CONCERN", "INSUFFICIENT_EVIDENCE"]},
    "counterargument": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Text"},
    "evidenceFactIds": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/FactId"}, "mpSortedUniqueBy": "$value"}
  },
  "$defs": {
    "BranchFields": {
      "type": "object",
      "properties": {
        "schemaVersion": true,
        "profile": true,
        "artifactType": true,
        "verdictId": true,
        "verdictHash": true,
        "producer": true,
        "operationId": true,
        "createdAt": true,
        "expiresAt": true,
        "candidateId": true,
        "candidateHash": true,
        "intentId": true,
        "intentHash": true,
        "eventId": true,
        "eventHash": true,
        "verdict": true,
        "reasonCode": true,
        "counterargument": true,
        "evidenceFactIds": true
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "APPROVE"}}, "required": ["verdict"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"reasonCode": {"const": "NO_BLOCKING_ISSUE"}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"verdict": {"const": "REJECT"}}, "required": ["verdict"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"reasonCode": {"enum": ["EVIDENCE_GAP", "THESIS_CONTRADICTION", "FIXTURE_POLICY_CONCERN"]}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"verdict": {"const": "ABSTAIN"}}, "required": ["verdict"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"reasonCode": {"const": "INSUFFICIENT_EVIDENCE"}}, "unevaluatedProperties": false}}
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false
}
