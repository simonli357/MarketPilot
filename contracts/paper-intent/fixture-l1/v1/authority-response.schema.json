{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketpilot:paper-intent-fixture:v1:authority-response",
  "type": "object", "additionalProperties": false, "unevaluatedProperties": false,
  "required": ["schemaVersion", "profile", "policyId", "messageType", "requestId", "operationId", "requestHash", "status", "primaryReasonCode", "reasonCodes", "gateDecision", "orderPlan", "executionEvent", "auditEvents", "headHash", "responseHash"],
  "properties": {"schemaVersion": {"const": 1}, "profile": {"const": "marketpilot.paper-intent-fixture.v1"}, "policyId": {"const": "FIXTURE_LONG_US_EQUITY_100_V1"}, "messageType": {"const": "FIXTURE_PAPER_INTENT_RESULT"}, "requestId": {"type": "string", "pattern": "^req_[a-z0-9_]{2,63}$"}, "operationId": {"type": "string", "pattern": "^op_[a-z0-9_]{2,63}$"}, "requestHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "status": {"enum": ["ACCEPTED", "REJECTED"]}, "primaryReasonCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "reasonCodes": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}}, "gateDecision": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:gate-decision"}, "orderPlan": {"oneOf": [{"type": "null"}, {"$ref": "urn:marketpilot:paper-intent-fixture:v1:order-plan"}]}, "executionEvent": {"oneOf": [{"type": "null"}, {"$ref": "urn:marketpilot:paper-intent-fixture:v1:execution-event"}]}, "auditEvents": {"type": "array", "maxItems": 16, "items": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:audit-event"}}, "headHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "responseHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  ,"allOf": [
    {"if": {"properties": {"status": {"const": "ACCEPTED"}}}, "then": {"required": ["orderPlan", "executionEvent"], "properties": {"primaryReasonCode": {"const": "ACCEPTED"}, "reasonCodes": {"const": ["ACCEPTED"]}, "orderPlan": {"type": "object"}, "executionEvent": {"type": "object"}}}},
    {"if": {"properties": {"status": {"const": "REJECTED"}}}, "then": {"properties": {"orderPlan": {"type": "null"}, "executionEvent": {"type": "null"}}}}
  ]
}
