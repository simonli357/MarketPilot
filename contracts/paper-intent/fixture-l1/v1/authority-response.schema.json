{
  "$schema": "urn:marketpilot:paper-intent-fixture:v1:meta",
  "$id": "urn:marketpilot:paper-intent-fixture:v1:authority-response",
  "type": "object",
  "required": ["schemaVersion", "profile", "policyId", "messageType", "requestId", "operationId", "requestHash", "status", "primaryReasonCode", "reasonCodes", "gateDecision", "orderPlan", "executionEvent", "auditEvents", "headHash", "responseHash"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"const": "marketpilot.paper-intent-fixture.v1"},
    "policyId": {"const": "FIXTURE_LONG_US_EQUITY_100_V1"},
    "messageType": {"const": "FIXTURE_PAPER_INTENT_RESULT"},
    "requestId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/RequestId"},
    "operationId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/OperationId"},
    "requestHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "status": {"enum": ["ACCEPTED", "REJECTED"]},
    "primaryReasonCode": {"anyOf": [{"const": "ACCEPTED"}, {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/DomainReasonCode"}]},
    "reasonCodes": {"type": "array", "minItems": 1, "maxItems": 26, "uniqueItems": true, "items": {"anyOf": [{"const": "ACCEPTED"}, {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/DomainReasonCode"}]}},
    "gateDecision": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:gate-decision"},
    "orderPlan": {"anyOf": [{"type": "null"}, {"$ref": "urn:marketpilot:paper-intent-fixture:v1:order-plan"}]},
    "executionEvent": {"anyOf": [{"type": "null"}, {"$ref": "urn:marketpilot:paper-intent-fixture:v1:execution-event"}]},
    "auditEvents": {"type": "array", "minItems": 4, "maxItems": 7, "items": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:audit-event"}},
    "headHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "responseHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"}
  },
  "$defs": {
    "BranchFields": {
      "type": "object",
      "properties": {
        "schemaVersion": true,
        "profile": true,
        "policyId": true,
        "messageType": true,
        "requestId": true,
        "operationId": true,
        "requestHash": true,
        "status": true,
        "primaryReasonCode": true,
        "reasonCodes": true,
        "gateDecision": true,
        "orderPlan": true,
        "executionEvent": true,
        "auditEvents": true,
        "headHash": true,
        "responseHash": true
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ACCEPTED"}}, "required": ["status"]},
      "then": {
        "$ref": "#/$defs/BranchFields",
        "properties": {
          "primaryReasonCode": {"const": "ACCEPTED"},
          "reasonCodes": {"const": ["ACCEPTED"]},
          "gateDecision": {"allOf": [{"$ref": "urn:marketpilot:paper-intent-fixture:v1:gate-decision"}, {"type": "object", "properties": {"decision": {"const": "ACCEPT"}}}]},
          "orderPlan": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:order-plan"},
          "executionEvent": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:execution-event"},
          "auditEvents": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:audit-event"}}
        },
        "unevaluatedProperties": false
      }
    },
    {
      "if": {"properties": {"status": {"const": "REJECTED"}}, "required": ["status"]},
      "then": {
        "$ref": "#/$defs/BranchFields",
        "properties": {
          "primaryReasonCode": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/DomainReasonCode"},
          "reasonCodes": {"type": "array", "minItems": 1, "maxItems": 26, "uniqueItems": true, "items": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/DomainReasonCode"}},
          "gateDecision": {"allOf": [{"$ref": "urn:marketpilot:paper-intent-fixture:v1:gate-decision"}, {"type": "object", "properties": {"decision": {"const": "REJECT"}}}]},
          "orderPlan": {"type": "null"},
          "executionEvent": {"type": "null"},
          "auditEvents": {"type": "array", "minItems": 4, "maxItems": 5, "items": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:audit-event"}}
        },
        "unevaluatedProperties": false
      }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false
}
