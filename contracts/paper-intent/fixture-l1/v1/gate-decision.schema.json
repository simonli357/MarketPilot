{
  "$schema": "urn:marketpilot:paper-intent-fixture:v1:meta",
  "$id": "urn:marketpilot:paper-intent-fixture:v1:gate-decision",
  "type": "object",
  "required": ["schemaVersion", "profile", "policyId", "artifactType", "decisionId", "decisionHash", "producer", "operationId", "requestHash", "decidedAt", "decision", "primaryReasonCode", "reasonCodes", "inputRefs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"const": "marketpilot.paper-intent-fixture.v1"},
    "policyId": {"const": "FIXTURE_LONG_US_EQUITY_100_V1"},
    "artifactType": {"const": "GateDecision"},
    "decisionId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/GateDecisionId"},
    "decisionHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "producer": {
      "allOf": [
        {"$ref": "urn:marketpilot:paper-intent-fixture:v1:producer"},
        {"type": "object", "properties": {"kind": {"const": "PYTHON_AUTHORITY"}}, "required": ["kind"]}
      ]
    },
    "operationId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/OperationId"},
    "requestHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
    "decidedAt": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/UtcTimestamp"},
    "decision": {"enum": ["ACCEPT", "REJECT"]},
    "primaryReasonCode": {
      "anyOf": [
        {"const": "ACCEPTED"},
        {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/DomainReasonCode"}
      ]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 26,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {"const": "ACCEPTED"},
          {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/DomainReasonCode"}
        ]
      }
    },
    "inputRefs": {
      "type": "object",
      "required": ["eventId", "eventHash", "candidateId", "candidateHash", "intentId", "intentHash", "verdictId", "verdictHash"],
      "properties": {
        "eventId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/ResearchEventId"},
        "eventHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
        "candidateId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/CandidateId"},
        "candidateHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
        "intentId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/TradeIntentId"},
        "intentHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"},
        "verdictId": {"anyOf": [{"type": "null"}, {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/CriticVerdictId"}]},
        "verdictHash": {"anyOf": [{"type": "null"}, {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"}]}
      },
      "oneOf": [
        {"properties": {"verdictId": {"type": "null"}, "verdictHash": {"type": "null"}}},
        {"properties": {"verdictId": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/CriticVerdictId"}, "verdictHash": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/Hash"}}}
      ],
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "BranchFields": {
      "type": "object",
      "properties": {
        "schemaVersion": true,
        "profile": true,
        "policyId": true,
        "artifactType": true,
        "decisionId": true,
        "decisionHash": true,
        "producer": true,
        "operationId": true,
        "requestHash": true,
        "decidedAt": true,
        "decision": true,
        "primaryReasonCode": true,
        "reasonCodes": true,
        "inputRefs": true
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "ACCEPT"}}, "required": ["decision"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"primaryReasonCode": {"const": "ACCEPTED"}, "reasonCodes": {"const": ["ACCEPTED"]}}, "unevaluatedProperties": false}},
    {"if": {"properties": {"decision": {"const": "REJECT"}}, "required": ["decision"]}, "then": {"$ref": "#/$defs/BranchFields", "properties": {"primaryReasonCode": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/DomainReasonCode"}, "reasonCodes": {"type": "array", "minItems": 1, "maxItems": 26, "uniqueItems": true, "items": {"$ref": "urn:marketpilot:paper-intent-fixture:v1:primitives#/$defs/DomainReasonCode"}}}, "unevaluatedProperties": false}}
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false
}
